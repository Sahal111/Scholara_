# ═══════════════════════════════════════════════════════════════════════════════
# .env.production.example — Template Konfigurasi Production Scholara
#
# CARA PENGGUNAAN:
#   1. Salin file ini: cp .env.production.example .env
#   2. Isi semua nilai yang bertanda <WAJIB_DIISI>
#   3. Pastikan file .env TIDAK pernah di-commit ke Git
#   4. Set permission: chmod 600 .env
#
# ⚠️  JANGAN gunakan .env.example (development) di production!
# ═══════════════════════════════════════════════════════════════════════════════

# ── APLIKASI ──────────────────────────────────────────────────────────────────
APP_NAME=Scholara
APP_ENV=production
APP_KEY=<WAJIB_DIISI: jalankan `php artisan key:generate` lalu salin hasilnya>
APP_DEBUG=false                          # ⚠️ WAJIB false di production
APP_URL=https://scholara.id              # <WAJIB_DIISI: URL utama platform>
FRONTEND_URL=https://scholara.id        # <WAJIB_DIISI: URL frontend React>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Naikkan bcrypt rounds di production untuk keamanan password yang lebih baik.
# 12 sudah aman; 13-14 lebih kuat tapi sedikit lebih lambat.
BCRYPT_ROUNDS=12

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily                          # Rotasi log harian, bukan single file besar
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                        # Di production: warning (bukan debug)

# ── DATABASE (MySQL) ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=<WAJIB_DIISI: IP atau hostname server MySQL>
DB_PORT=3306
DB_DATABASE=<WAJIB_DIISI: nama database, contoh: scholara_prod>
DB_USERNAME=<WAJIB_DIISI: username MySQL dengan privilege minimal>
DB_PASSWORD=<WAJIB_DIISI: password kuat, min 32 karakter>

# ── SESSION ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis                     # Redis lebih cepat dan scalable dari database
SESSION_LIFETIME=480                     # 8 jam (menit)
SESSION_ENCRYPT=true                     # Enkripsi session payload
SESSION_PATH=/
SESSION_DOMAIN=.scholara.id             # Leading dot agar berlaku untuk semua subdomain
SESSION_SECURE_COOKIE=true              # ⚠️ WAJIB true di production (HTTPS only)

# ── QUEUE ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis                   # Redis lebih reliable dari database untuk queue
# Pastikan supervisor/worker berjalan: php artisan queue:work --tries=3

# ── CACHE ─────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=scholara_

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis                      # Gunakan predis (sudah ada di composer.json)
REDIS_HOST=<WAJIB_DIISI: IP atau hostname server Redis>
REDIS_PASSWORD=<WAJIB_DIISI: password Redis, jangan biarkan null di production>
REDIS_PORT=6379

# ── BROADCAST ─────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log                 # Ganti ke reverb/pusher jika pakai realtime

# ── FILESYSTEM ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# Untuk cloud storage: ganti ke s3, tambahkan AWS_* vars di bawah

# ── EMAIL ─────────────────────────────────────────────────────────────────────
# Wajib dikonfigurasi untuk: notifikasi reset password, pengumuman sekolah.
MAIL_MAILER=smtp                         # Gunakan SMTP di production (bukan 'log')
MAIL_SCHEME=tls
MAIL_HOST=<WAJIB_DIISI: SMTP host, contoh: smtp.gmail.com atau smtp.mailgun.org>
MAIL_PORT=587
MAIL_USERNAME=<WAJIB_DIISI: email/username SMTP>
MAIL_PASSWORD=<WAJIB_DIISI: password atau API key SMTP>
MAIL_FROM_ADDRESS=noreply@scholara.id
MAIL_FROM_NAME="Scholara"

# ── SANCTUM ───────────────────────────────────────────────────────────────────
# Daftar domain yang diizinkan untuk stateful auth (cookie-based Sanctum).
# Tambahkan semua subdomain sekolah, atau gunakan wildcard jika supported.
# Format: comma-separated, tanpa spasi, tanpa https://.
SANCTUM_STATEFUL_DOMAINS=scholara.id,*.scholara.id
# Token expiry: 7 hari dalam menit
SANCTUM_TOKEN_EXPIRATION=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dikonfigurasi di config/cors.php — pastikan allowed_origins tidak '*'
# dan hanya daftar domain yang benar-benar diizinkan.

# ── AWS S3 (Opsional — untuk cloud storage foto dan dokumen) ──────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ── MONITORING (Opsional tapi sangat disarankan) ──────────────────────────────
# Sentry untuk error tracking
# SENTRY_LARAVEL_DSN=<isi dari dashboard Sentry>

# ── CATATAN KEAMANAN ──────────────────────────────────────────────────────────
# 1. Pastikan .env tidak ter-expose via web server (cek konfigurasi Nginx/Apache)
# 2. Gunakan secret manager (AWS Secrets Manager, HashiCorp Vault) jika memungkinkan
# 3. Rotasi APP_KEY, database password, dan Redis password secara berkala
# 4. Backup database secara otomatis (harian minimum)
# 5. Set up monitoring alert untuk error rate dan response time

